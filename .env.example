# Copy to .env and adjust. Compose reads this file for variable substitution only.

# Image tag to run (a released version such as 0.1.0, or latest).
VERSION=latest

# Host port the dashboard is published on.
MYDASHBOARD_PORT=8080

# Your manifest and icon directory.
MYDASHBOARD_MANIFEST_FILE=./config/services.json
MYDASHBOARD_ICONS_DIR=./public/icons
